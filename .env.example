# Local development uses file:data/agentclinic.sqlite by default.
# AGENTCLINIC_DB=data/agentclinic.sqlite

# Notification previews default to .agentclinic-notifications/.
# AGENTCLINIC_NOTIFICATION_PREVIEW_DIR=.agentclinic-notifications
# The local preview transport is not run in the Vercel public demo.

# Set both values for a remote Turso/libSQL database.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-local-secret

# Read-only release smoke target; HTTPS is required except for localhost.
# AGENTCLINIC_BASE_URL=https://your-deployment.example
